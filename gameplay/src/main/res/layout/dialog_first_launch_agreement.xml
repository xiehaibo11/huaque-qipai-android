<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/first_launch_agreement_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/first_launch_agreement_root"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/first_launch_agreement_action_row"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/first_launch_agreement_reject"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/first_launch_agreement_reject"
            android:elevation="0dp"
            android:fontFamily="sans-serif"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="25dp"
            android:paddingTop="7dp"
            android:paddingEnd="25dp"
            android:paddingBottom="10dp"
            android:text="@string/first_launch_agreement_reject"
            android:textAllCaps="false"
            android:textColor="@color/first_launch_agreement_reject_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            tools:ignore="ButtonStyle" />

        <Button
            android:id="@+id/first_launch_agreement_accept"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/first_launch_agreement_accept"
            android:elevation="0dp"
            android:fontFamily="sans-serif"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="25dp"
            android:paddingTop="7dp"
            android:paddingEnd="25dp"
            android:paddingBottom="10dp"
            android:text="@string/first_launch_agreement_accept"
            android:textAllCaps="false"
            android:textColor="@color/first_launch_agreement_accept_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            tools:ignore="ButtonStyle" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/first_launch_agreement_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/first_launch_agreement_title"
        android:layout_marginBottom="100dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="19dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="19dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/first_launch_agreement_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@color/first_launch_agreement_panel"
                android:fontFamily="sans-serif"
                android:padding="10dp"
                android:text="@string/first_launch_agreement_body"
                android:textColor="@color/first_launch_agreement_primary_text"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/first_launch_agreement_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/first_launch_agreement_title_background"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/first_launch_agreement_title"
        android:textColor="@color/first_launch_agreement_title_text"
        android:textSize="23sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/first_launch_agreement_action_row"
        android:layout_marginStart="19dp"
        android:layout_marginEnd="19dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/first_launch_agreement_links"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:textColor="@color/first_launch_agreement_primary_text"
            android:textSize="14sp" />
    </LinearLayout>
</RelativeLayout>
