<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/real_name_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/real_name_panel"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/real_name_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:padding="6dp"
        android:textColor="@color/real_name_title_text"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="@string/real_name_title_form" />

    <com.nanbeiyule.game.MaxHeightScrollView
        android:id="@+id/real_name_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/real_name_verified_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/real_name_verified_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/real_name_badge_background"
            android:fontFamily="sans-serif"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:text="@string/real_name_verified_badge"
            android:textColor="@color/real_name_badge_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/real_name_label_name"
                android:textColor="@color/real_name_secondary_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/real_name_verified_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:textColor="@color/real_name_primary_text"
                android:textSize="15sp"
                tools:text="*X" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/real_name_label_id_card"
                android:textColor="@color/real_name_secondary_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/real_name_verified_id_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:textColor="@color/real_name_primary_text"
                android:textSize="15sp"
                tools:text="1101**********1237" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/real_name_form_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/real_name_input_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/real_name_input_background"
            android:fontFamily="sans-serif"
            android:hint="@string/real_name_hint_name"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:maxLength="30"
            android:padding="10dp"
            android:textColor="@color/real_name_primary_text"
            android:textColorHint="@color/real_name_secondary_text"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/real_name_input_id_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/real_name_input_background"
            android:fontFamily="sans-serif"
            android:hint="@string/real_name_hint_id_card"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="18"
            android:padding="10dp"
            android:textColor="@color/real_name_primary_text"
            android:textColorHint="@color/real_name_secondary_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/real_name_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/real_name_error_text"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="@string/real_name_error_id_card_invalid"
            tools:visibility="visible" />

        <Button
            android:id="@+id/real_name_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/real_name_submit_background"
            android:fontFamily="sans-serif"
            android:text="@string/real_name_submit"
            android:textAllCaps="false"
            android:textColor="@color/real_name_submit_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/real_name_alipay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/real_name_alipay_background"
            android:fontFamily="sans-serif"
            android:text="@string/real_name_alipay"
            android:textAllCaps="false"
            android:textColor="@color/real_name_alipay_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/real_name_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:text="@string/real_name_notice"
            android:textColor="@color/real_name_secondary_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/real_name_customer_service"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/real_name_customer_service"
            android:textColor="@color/real_name_secondary_text"
            android:textSize="12sp" />
    </LinearLayout>

    </LinearLayout>
    </com.nanbeiyule.game.MaxHeightScrollView>

    <Button
        android:id="@+id/real_name_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@color/real_name_close_background"
        android:fontFamily="sans-serif"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="@string/real_name_close"
        android:textAllCaps="false"
        android:textColor="@color/real_name_close_text"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
